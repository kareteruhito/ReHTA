<!DOCTYPE html>
<html lang="ja">

<head>
<meta charset="UTF-8">
<title>ReHTA Sample</title>

<style>
    body {
        font-family: sans-serif;
        margin: 30px;
    }

    textarea {
        width: 100%;
        height: 150px;
        box-sizing: border-box;
    }

    button {
        margin-top: 10px;
        padding: 8px 20px;
    }

    #status {
        margin-top: 15px;
    }
</style>
</head>

<body>

<h1>ReHTA Sample</h1>

<p>保存するテキストを入力してください。</p>

<textarea id="editor">Hello ReHTA!</textarea>

<p>
    <button onclick="save()">
        ファイルに保存
    </button>
</p>

<div id="status"></div>

<script>
    async function save() {
        const text =
            document.getElementById("editor").value;

        const status =
            document.getElementById("status");

        try {
            await rehta.writeText("save.txt", text);

            status.textContent =
                "保存しました。";
        }
        catch (error) {
            status.textContent =
                "エラー: " + error.message;
        }
    }
</script>

</body>
</html>