<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>ReHTA メモ帳</title>

<style>
    body {
        font-family: sans-serif;
        margin: 20px;
        background: #f5f5f5;
    }

    h1 {
        font-size: 20px;
    }

    textarea {
        width: 100%;
        height: 350px;
        box-sizing: border-box;
        padding: 10px;
        font-family: monospace;
        font-size: 16px;
        resize: vertical;
    }

    button {
        margin-top: 10px;
        padding: 8px 24px;
        font-size: 16px;
        cursor: pointer;
    }

    #status {
        margin-top: 10px;
        color: #555;
    }
</style>
</head>

<body>

<h1>ReHTA メモ帳</h1>

<textarea id="editor"
    placeholder="ここにメモを入力してください"></textarea>

<div>
    <button id="saveButton" onclick="save()">
        保存
    </button>
</div>

<div id="status"></div>

<script>
    const editor = document.getElementById("editor");
    const status = document.getElementById("status");
    const saveButton = document.getElementById("saveButton");

    // 起動時にmemo.txtを読み込む
    async function load() {
        try {
            editor.value = await rehta.readText("memo.txt");
            status.textContent = "準備完了";
        }
        catch (error) {
            status.textContent =
                "読み込みエラー: " + error.message;

            saveButton.disabled = true;
        }
    }

    // 保存ボタン
    async function save() {
        saveButton.disabled = true;

        try {
            await rehta.writeText(
                "memo.txt",
                editor.value
            );

            status.textContent = "保存しました。";
        }
        catch (error) {
            status.textContent =
                "保存エラー: " + error.message;
        }
        finally {
            saveButton.disabled = false;
        }
    }

    // 起動時に実行
    load();
</script>

</body>
</html>